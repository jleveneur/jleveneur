{
  "version": 1,
  "servers": {
    "next-devtools": {
      "transport": "stdio",
      "command": "bunx",
      "args": ["next-devtools-mcp@latest"]
    },
    "playwright": {
      "transport": "stdio",
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--browser", "chromium"]
    },
    "reui": {
      "transport": "http",
      "url": "https://mcp.reui.io"
    },
    "shadcn": {
      "transport": "stdio",
      "command": "bunx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}
