{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./tooling/oxlint/base.json"],
  // JS plugins are alpha in Oxlint and are resolved from this file, not from
  // an extended config. Settings are read from the root config only.
  "jsPlugins": ["@shadcn/lint"],
  "options": {
    // Type-aware linting via oxlint-tsgolint, which is built on typescript-go.
    // This is root-only configuration.
    "typeAware": true
  },
  // Extends does not always merge ignorePatterns into the root config.
  "ignorePatterns": ["**/next-env.d.ts"],
  "settings": {
    "shadcn": {
      // Matches `aliases.ui` in apps/web/components.json and the @repo/ui export.
      "ui": "@repo/ui/components"
    }
  },
  "rules": {
    // Call sites may place a component (width, margin, flex). They may not
    // restyle it. Spacing, including `gap-*` on CardContent, stays on a plain
    // element around the component.
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    // Layout arbitrary values (`w-[…]`, `top-[…]`) are placement, not a
    // palette escape. Appearance arbitrary values stay forbidden.
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },

  "overrides": [
    {
      // apps/web declares `@/*` → `./src/*` (no `baseUrl`).
      // Parent-relative imports are the pattern the alias exists to replace.
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*", "../**"],
                "message": "Use the @/ path alias for imports across folders."
              }
            ]
          }
        ]
      }
    },
    {
      // Config files and setup scripts run before anything else exists, and
      // are not shipped code — stdout is how a CLI reports what it did.
      "files": ["**/*.config.*", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Tests may assert on promise rejections and construct partial fixtures.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ]
}
