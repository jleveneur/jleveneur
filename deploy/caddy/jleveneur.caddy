# The portfolio's Caddy sites. The server's global Caddyfile holds the global
# options and imports every project's file from /etc/caddy/sites/; the deploy
# workflow installs this one as /etc/caddy/sites/jleveneur.caddy. Snippet names
# start with `jleveneur-` because every project's file shares one namespace.
#
# The site is the standalone Next.js server of `apps/portfolio`, which
# deploy/portfolio/compose.yml publishes on 127.0.0.1:3500 alone. Security
# headers come from the app (`apps/portfolio/next.config.ts`), so they are not
# repeated here. Compression is Caddy's alone (`compress: false` in
# next.config.ts): zstd for the browsers that take it, gzip for the others,
# where Next would only gzip and Caddy would pass that through as it is.
#
# Caddy replaces any X-Forwarded-For a client sends with the address it saw,
# so the contact form's rate limit counts the visitor, not a header they chose.
#
# The access log holds visitors' IP addresses, and the privacy policy
# (apps/portfolio/src/content/legal.ts) promises they are kept 90 days at most:
# every site's file rolls daily whatever the traffic, and a rolled file is
# deleted after 90 days. Caddy applies a change to these options on restart,
# not on reload.

(jleveneur-encode) {
	encode zstd gzip
}

(jleveneur-access-log) {
	log {
		output file /var/log/caddy/jleveneur.access.log {
			roll_size 50MiB
			roll_interval 1d
			roll_keep 10
			roll_keep_for 90d
		}
	}
}

jleveneur.com {
	import jleveneur-access-log
	import jleveneur-encode
	reverse_proxy 127.0.0.1:3500
}

# One canonical host: the path and the query string carry over.
www.jleveneur.com {
	import jleveneur-access-log
	redir https://jleveneur.com{uri} permanent
}
