# The portfolio's Caddy sites. The server's global Caddyfile holds the global
# options and imports every project's file from /etc/caddy/sites/; the deploy
# workflow installs this one as /etc/caddy/sites/jleveneur.caddy. Snippet names
# start with `jleveneur-` because every project's file shares one namespace.
#
# The site is the static export of `apps/portfolio`: the workflow syncs `out/`
# to /srv/jleveneur/releases/<commit> and points /srv/jleveneur/current at it.

# What Cloudflare applied from `public/_headers`. `frame-ancestors`,
# `base-uri`, and `object-src` are the CSP directives that need no knowledge of
# the page; HSTS covers the subdomains, which are all served over HTTPS here.
(jleveneur-headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}
}

(jleveneur-access-log) {
	log {
		output file /var/log/caddy/jleveneur.access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

jleveneur.com {
	import jleveneur-access-log
	import jleveneur-headers
	root * /srv/jleveneur/current
	encode zstd gzip

	# Build assets carry a hash in their name, so they never change under it.
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		root * /srv/jleveneur/current
		import jleveneur-headers
		rewrite * /404.html
		file_server
	}
}

# One canonical host: the path and the query string carry over.
www.jleveneur.com {
	import jleveneur-access-log
	redir https://jleveneur.com{uri} permanent
}
