# Uptime Kuma's Caddy site, installed as /etc/caddy/sites/uptime-kuma.caddy by
# the deploy workflow with deploy/uptime-kuma/compose.yml. Snippet names start with
# `uptime-kuma-` because every project's file shares one namespace.

# The dashboard's assets are compressed; its live updates go over a WebSocket,
# which `encode` leaves alone once the connection is upgraded.
(uptime-kuma-encode) {
	encode zstd gzip
}

(uptime-kuma-access-log) {
	log {
		output file /var/log/caddy/uptime-kuma.access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

# The dashboard and its websocket. Sign-in is Uptime Kuma's own; jleveneur.com's
# HSTS already covers the subdomain.
status.jleveneur.com {
	import uptime-kuma-access-log
	import uptime-kuma-encode
	reverse_proxy 127.0.0.1:3200
}
