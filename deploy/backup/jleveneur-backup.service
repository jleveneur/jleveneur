# Runs deploy/backup/backup.sh once: Umami, Uptime Kuma and Beszel to R2.
# Started by jleveneur-backup.timer, or by hand:
# `sudo systemctl start jleveneur-backup.service`, then
# `journalctl -u jleveneur-backup.service` for the outcome.
#
# Installed once on the server by deploy/vps/install-backups.sh, with the
# timer. The deploy workflow keeps /srv/backup/jleveneur-backup.sh current.

[Unit]
Description=Back up Umami, Uptime Kuma and Beszel to R2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
# The R2 key every backup on the VPS shares, then this backup's own settings.
EnvironmentFile=/srv/backup/r2.env
EnvironmentFile=-/srv/backup/backup.env
ExecStart=/srv/backup/jleveneur-backup.sh
TimeoutStartSec=30min
