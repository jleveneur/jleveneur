{
  "name": "@repo/portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Julien Leveneur's public site.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:vinext": "vinext dev --port 3001",
    "typegen": "next typegen",
    "build": "next build",
    "build:vinext": "vinext build",
    "start": "next start --port 3001",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "workers:deploy": "wrangler deploy --config dist/server/wrangler.json",
    "workers:preview": "wrangler versions upload --config dist/server/wrangler.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@vinext/cloudflare": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "vinext": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/tailwind-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@12.3.0"
}
