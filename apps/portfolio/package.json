{
  "name": "@repo/portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Julien Leveneur's public site.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "typegen": "next typegen",
    "build": "next build",
    "build:export": "PORTFOLIO_EXPORT=1 next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && bun check",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/tailwind-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
