{
  "extends": "@repo/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
