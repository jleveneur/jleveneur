{
  "mcpServers": {
    "next-devtools": {
      "command": "bunx",
      "args": ["next-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp@latest", "--browser", "chromium"]
    },
    "reui": {
      "url": "https://mcp.reui.io"
    },
    "shadcn": {
      "command": "bunx",
      "args": ["shadcn@latest", "mcp"]
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
