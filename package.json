{
  "name": "@repo/root",
  "version": "0.0.0",
  "private": true,
  "description": "Julien Leveneur's site, based on the Next.js monorepo starter.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "bun run --cwd apps/starter typegen && bun run --cwd apps/portfolio typegen && oxlint --type-aware",
    "lint:fix": "bun run --cwd apps/starter typegen && bun run --cwd apps/portfolio typegen && oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip-bun",
    "react-doctor": "react-doctor --no-telemetry --no-supply-chain --yes",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run react-doctor && bun run test",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "prepare": "bun scripts/install-hooks.ts",
    "new-project": "bun scripts/new-project.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@shadcn/lint": "0.2.0",
    "@types/node": "24.19.1",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.61.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.14",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ]
}
