{
  "name": "@jleveneur/agentcfg",
  "version": "0.4.2",
  "description": "One MCP config for Cursor, Claude Code, Codex, VS Code, and Gemini CLI, shared skills, and a scan of every MCP server and skill on the machine.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "gemini-cli",
    "mcp",
    "model-context-protocol",
    "skills",
    "vscode",
    "windsurf"
  ],
  "homepage": "https://github.com/jleveneur/jleveneur/tree/main/packages/agentcfg#readme",
  "bugs": {
    "url": "https://github.com/jleveneur/jleveneur/issues"
  },
  "license": "MIT",
  "author": "Julien Leveneur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jleveneur/jleveneur.git",
    "directory": "packages/agentcfg"
  },
  "bin": {
    "agentcfg": "dist/bin.js"
  },
  "files": [
    "dist",
    "agentcfg.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "test": "node --test test/agentcfg.test.ts test/scan.test.ts test/skills.test.ts test/status.test.ts",
    "test:live": "node --test test/live.test.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
