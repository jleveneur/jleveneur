{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "oRPC procedures and the application router.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test --isolate --path-ignore-patterns='**/*.integration.test.ts' ./src",
    "test:watch": "bun test --watch --path-ignore-patterns='**/*.integration.test.ts' ./src",
    "test:integration": "bun test --isolate --timeout=30000 integration.test"
  },
  "dependencies": {
    "@orpc/server": "2.0.0-beta.37",
    "@repo/auth": "workspace:*",
    "@repo/authz": "workspace:*",
    "@repo/db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
