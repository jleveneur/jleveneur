{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  // Agent guidance lives in the repository's own AGENTS.md; turbo would
  // otherwise append a managed block to it whenever an agent runs a command.
  "agentGuidance": false,
  // Every task misses when one of these changes, so only what reaches every
  // task belongs here. The lockfile is always in the global hash; the shared
  // tsconfig and Tailwind packages reach the tasks that read them through the
  // package graph (`^build`, `transit`); lint runs outside Turbo.
  "globalDependencies": ["bunfig.toml"],
  // `CI` is not here: only the Playwright configs read it, so it is declared on
  // `test:e2e`. Hashed globally, it kept every local hash apart from CI's.
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["FORCE_COLOR", "TERM"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Next loads the app's `.env` files while the build runs, which Turbo does
      // not see (they are not committed): listed so a change misses.
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**"],
      // `next build` evaluates route modules, which validate the environment.
      // The values do not end up in the output — no NEXT_PUBLIC_* variable
      // exists — but they must be present for the build to run at all.
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "MAIL_OUTBOX_DIR",
        "AUTH_RATE_LIMIT",
        "LOG_LEVEL"
      ]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },

    // A transit node: it runs nothing, but a task that depends on `transit`
    // takes the hashes of the internal packages it imports (the pattern of
    // Turborepo's docs). typecheck, test, and test:e2e read those packages'
    // source, so without it a change in a package would replay an app's
    // cached pass on code it never checked. They still fan out in parallel:
    // `transit` has no script to wait for.
    "transit": {
      "dependsOn": ["^transit"]
    },

    "typecheck": {
      "dependsOn": ["transit"],
      // `bun check` reports and writes nothing.
      "outputs": []
    },

    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },

    // Needs a live database, so it is never part of the default local loop and
    // is never cached — a pass proves the schema and the code agreed at the
    // moment it ran, which is not a property of the inputs alone.
    //
    // Turbo filters the environment it hands a task, so anything the code
    // reads has to be listed here or it silently falls back to a default.
    "test:integration": {
      "dependsOn": [],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "MAIL_OUTBOX_DIR",
        "AUTH_RATE_LIMIT",
        "LOG_LEVEL"
      ]
    },

    // Browser journeys against a real build, which Playwright starts itself
    // (building through Turbo). Cached: CI migrates a fresh database and the
    // suites set up their own data, so a pass is a property of the inputs —
    // the app, the packages it imports (through `transit`), the lockfile, and
    // the declared variables, `CI` among them. After a merge, `main` replays
    // the pass its PR earned on the same tree. A failure is never cached.
    "test:e2e": {
      "dependsOn": ["transit"],
      // The server Playwright starts loads the app's `.env` files.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "MAIL_OUTBOX_DIR",
        "AUTH_RATE_LIMIT",
        "LOG_LEVEL",
        "PLAYWRIGHT_*",
        "CI"
      ]
    }
  }
}
